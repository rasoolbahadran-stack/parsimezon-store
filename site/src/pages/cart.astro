---
import Base from '../layouts/Base.astro';
import { BASE } from '../lib/site';
---

<Base title="سبد خرید" desc="سبد خرید شما در پارسی‌مزون؛ اعمال کد تخفیف، محاسبه ارسال و ادامه خرید">
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__t">سبد خرید</h1>
      <p class="breadcrumb"><a href={BASE + '/'}>خانه</a> / سبد خرید</p>
    </div>
  </section>

  <div class="container cart-page">
    <div id="cart-page-body"></div>
  </div>
</Base>

<script is:inline>
  (function () {
    const base = document.querySelector('link[rel=icon]').getAttribute('href').replace('/favicon.svg', '');
    const fa = (n) => new Intl.NumberFormat('fa-IR').format(n);
    const body = document.getElementById('cart-page-body');

    function render() {
      const products = JSON.parse(localStorage.getItem('ps_products') || '[]');
      const settings = JSON.parse(localStorage.getItem('ps_settings') || '{}');
      const lines = JSON.parse(localStorage.getItem('ps_cart') || '[]');
      if (!lines.length) {
        body.innerHTML = `
          <div class="cart-empty" style="padding-top:70px">
            <div class="cart-empty__icon">🛍️</div>
            <p style="margin-bottom:16px">سبد خرید شما خالی است.</p>
            <a class="btn btn-dark" href="${base}/shop">مشاهده محصولات</a>
          </div>`;
        return;
      }
      let subtotal = 0;
      const rows = lines.map((l, i) => {
        const p = products.find((x) => x.id === l.id);
        if (!p) return '';
        let price = p.price, vname = '';
        if (l.variant && p.variants) {
          const v = p.variants.find((x) => `${x.color} / ${x.size}` === l.variant);
          if (v) { price = v.price ?? p.price; vname = `${v.color} / ${v.size}`; }
        }
        const sum = price * l.qty;
        subtotal += sum;
        return `
        <tr>
          <td style="display:flex;gap:12px;align-items:center">
            <a href="${base}/product/${p.slug}"><img src="${base}/assets/img/${p.images[0]}.webp" alt="${p.name}"></a>
            <div>
              <a href="${base}/product/${p.slug}"><b style="font-size:13px">${p.name}</b></a>
              <p class="product-card__cat">${vname}</p>
            </div>
          </td>
          <td class="hide-m">${fa(price)} تومان</td>
          <td>
            <span class="qty" style="margin:0">
              <button data-dec="${i}">−</button><input value="${l.qty}" readonly><button data-inc="${i}">+</button>
            </span>
          </td>
          <td><b>${fa(sum)} تومان</b></td>
          <td><button class="cart-line__rm" data-rm="${i}">حذف</button></td>
        </tr>`;
      }).join('');

      const freeOver = settings.freeShippingThreshold || 3000000;
      const pct = Math.min(100, Math.round((subtotal / freeOver) * 100));
      body.innerHTML = `
        <div class="checkout-layout" id="cart-grid">
          <div>
            <div class="checkout-card">
              <p class="checkout-card__t">اقلام سفارش (${fa(lines.length)} خط)</p>
              <div style="overflow-x:auto">
                <table class="table table--cart">
                  <thead><tr><th>محصول</th><th class="hide-m">قیمت واحد</th><th>تعداد</th><th>جمع</th><th></th></tr></thead>
                  <tbody>${rows}</tbody>
                </table>
              </div>
            </div>
            <div class="checkout-card">
              <p class="checkout-card__t">کد تخفیف</p>
              <div class="coupon-row">
                <input id="coupon-input" placeholder="مثلاً WELCOME10">
                <button class="btn btn-dark btn-sm" id="coupon-btn">اعمال</button>
              </div>
              <p class="cart-line__v" id="coupon-msg"></p>
            </div>
          </div>
          <div class="cart-summary">
            <p class="cart-summary__t">خلاصه سفارش</p>
            <div class="cart-ship-track" style="margin:0 0 8px"><i style="width:${pct}%"></i></div>
            <p class="cart-line__v" style="margin-bottom:12px">${subtotal >= freeOver ? '🎉 ارسال این سفارش رایگان است' : 'تا ارسال رایگان: ' + fa(freeOver - subtotal) + ' تومان'}</p>
            <div class="sum-row"><span>جمع کالاها</span><span>${fa(subtotal)} تومان</span></div>
            <div class="sum-row" id="sum-discount" style="display:none; color:var(--c-success)"><span>تخفیف</span><span id="discount-val"></span></div>
            <div class="sum-row" id="sum-ship"><span>هزینه ارسال (پست پیشتاز)</span><span>${subtotal >= freeOver ? 'رایگان' : fa(89000) + ' تومان'}</span></div>
            <div class="sum-row is-total"><span>قابل پرداخت</span><span id="grand-total"></span></div>
            <a class="btn btn-primary btn-block" style="margin-top:14px" href="${base}/checkout" id="go-checkout">ادامه فرایند خرید</a>
            <a class="btn btn-default btn-block btn-sm" style="margin-top:8px" href="${base}/shop">افزودن محصول بیشتر</a>
          </div>
        </div>
        <div style="margin-top:44px">
          <div class="section-head"><h2 class="section-title" style="font-size:20px"><small>SUGGESTED</small>پیشنهاد تکمیل استایل</h2></div>
          <div class="product-grid" id="cart-suggest"></div>
        </div>`;

      let discount = 0, couponCode = '';
      /* بازیابی کوپن از sessionStorage اگر قبلا اعمال شده */
      const savedCtx = JSON.parse(sessionStorage.getItem('ps_checkout_ctx') || '{}');
      if (savedCtx.couponCode) { couponCode = savedCtx.couponCode; discount = savedCtx.discount || 0; }

      function totals() {
        const ship = subtotal >= freeOver ? 0 : 89000;
        return { ship, total: Math.max(0, subtotal - discount) + ship };
      }
      function paint() {
        const { ship, total } = totals();
        document.getElementById('grand-total').textContent = fa(total) + ' تومان';
        document.getElementById('sum-ship').lastElementChild.textContent = ship === 0 ? 'رایگان' : fa(ship) + ' تومان';
        const dRow = document.getElementById('sum-discount');
        if (discount > 0) {
          dRow.style.display = 'flex';
          document.getElementById('discount-val').textContent = '−' + fa(discount) + ' تومان';
        } else dRow.style.display = 'none';
      }
      paint();

      document.getElementById('coupon-btn').addEventListener('click', () => {
        const code = document.getElementById('coupon-input').value.trim().toUpperCase();
        const coupons = JSON.parse(localStorage.getItem('ps_coupons') || '[]');
        const c = coupons.find((x) => x.code.toUpperCase() === code && x.active);
        const msg = document.getElementById('coupon-msg');
        if (!c) { msg.textContent = 'کد تخفیف نامعتبر است'; msg.style.color = 'var(--c-primary)'; return; }
        if (subtotal < (c.minOrder || 0)) { msg.textContent = 'حداقل مبلغ سفارش: ' + fa(c.minOrder) + ' تومان'; msg.style.color = 'var(--c-primary)'; return; }
        discount = c.type === 'percent' ? Math.round(subtotal * c.amount / 100) : c.amount;
        if (c.maxDiscount && c.maxDiscount > 0) discount = Math.min(discount, c.maxDiscount);
        discount = Math.min(discount, subtotal);
        couponCode = c.code;
        msg.textContent = 'کد تخفیف «' + c.code + '» اعمال شد ✓' + (c.maxDiscount ? ' (سقف ' + fa(c.maxDiscount) + ' تومان)' : '');
        msg.style.color = 'var(--c-success)';
        paint();
      });

      document.querySelectorAll('[data-inc]').forEach((b) => b.addEventListener('click', () => {
        const l = lines[b.dataset.inc];
        const p = products.find((x) => x.id === l.id);
        const max = p ? p.stock || 99 : 99;
        if (l.qty < max) l.qty++;
        savePaint();
      }));
      document.querySelectorAll('[data-dec]').forEach((b) => b.addEventListener('click', () => { if (lines[b.dataset.dec].qty > 1) lines[b.dataset.dec].qty--; else lines.splice(b.dataset.dec, 1); savePaint(); }));
      document.querySelectorAll('[data-rm]').forEach((b) => b.addEventListener('click', () => { lines.splice(b.dataset.rm, 1); discount = 0; couponCode = ''; savePaint(); }));

      function savePaint() {
        localStorage.setItem('ps_cart', JSON.stringify(lines));
        sessionStorage.setItem('ps_checkout_ctx', JSON.stringify({ discount, couponCode }));
        window.__psRefreshBadge && window.__psRefreshBadge();
        render();
      }
      document.getElementById('go-checkout').addEventListener('click', () => {
        sessionStorage.setItem('ps_checkout_ctx', JSON.stringify({ discount, couponCode }));
      });

      /* پیشنهاد تکمیل استایل */
      const sug = products.filter((p) => p.status === 'published' && p.bestseller).slice(0, 4);
      document.getElementById('cart-suggest').innerHTML = sug.map((p) => `
        <article class="product-card">
          <div class="product-card__media">
            ${p.oldPrice ? '<span class="badge badge--sale">تخفیف</span>' : p.isNew ? '<span class="badge badge--new">جدید</span>' : ''}
            <a href="${base}/product/${p.slug}"><img src="${base}/assets/img/${p.images[0]}.webp" alt="${p.name}" loading="lazy"></a>
          </div>
          <div class="product-card__body">
            <a href="${base}/product/${p.slug}"><h3 class="product-card__title">${p.name}</h3></a>
            <div class="price"><span class="price__current">${p.oldPrice ? `<del>${fa(p.oldPrice)}</del>` : ''}${fa(p.price)}</span><span class="price__unit">تومان</span></div>
          </div>
        </article>`).join('');
    }
    render();
  })();
</script>
