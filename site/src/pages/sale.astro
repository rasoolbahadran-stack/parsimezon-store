---
import Base from '../layouts/Base.astro';
import ShopBrowser from '../components/ShopBrowser.astro';
import { BASE } from '../lib/site';
---

<Base title="تخفیف‌های ویژه | پارسی‌مزون" desc="جشنواره فصلی پارسی‌مزون — تخفیف تا ۳۵٪ روی مدل‌های منتخب زمستان؛ فرصت محدود">
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__t">تخفیف‌های ویژه</h1>
      <p class="breadcrumb"><a href={BASE + '/'}>خانه</a> / <a href={BASE + '/shop'}>فروشگاه</a> / تخفیف‌ها</p>
      <div class="shop-head-meta" style="margin-top:10px">
        <span>جشنواره فصلی — تا <b>٪۳۵</b> تخفیف روی مدل‌های منتخب</span>
        <span>فرصت محدود</span>
      </div>
    </div>
  </section>
  <div style="padding-top:6px">
    <ShopBrowser presetSale={true} presetSort="sale" />
  </div>
</Base>
