---
import Base from '../layouts/Base.astro';
import ShopBrowser from '../components/ShopBrowser.astro';
import { BASE, categories, fa, products } from '../lib/site';
const count = fa(products.filter((p: any) => p.status === 'published').length);
---

<Base title="فروشگاه پارسی‌مزون | خرید آنلاین پوشاک زنانه" desc="خرید آنلاین پوشاک زنانه پارسی‌مزون؛ پالتو، مانتو، شومیز، بافت، لباس مجلسی و اکسسوری با فیلتر رنگ، سایز و قیمت — ۹۲ محصول منتخب با ارسال سریع">
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__t">فروشگاه پارسی‌مزون</h1>
      <p class="breadcrumb"><a href={BASE + '/'}>خانه</a> / فروشگاه</p>
      <div class="shop-head-meta" style="margin-top:10px">
        <span><b>{count}</b> محصول منتخب</span>
        <span>ارسال رایگان بالای ۳ میلیون تومان</span>
        <span>۷ روز ضمانت بازگشت</span>
      </div>
    </div>
  </section>

  <div style="padding-top:6px">
    <ShopBrowser showCats={true}>
      {categories.map((c: any) => <button class="cat-chip" data-slug={c.slug}>{c.name}</button>)}
    </ShopBrowser>
  </div>
</Base>
