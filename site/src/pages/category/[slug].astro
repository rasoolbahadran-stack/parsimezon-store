---
import Base from '../../layouts/Base.astro';
import ShopBrowser from '../../components/ShopBrowser.astro';
import { BASE, img, categories, products, articles, fa } from '../../lib/site';

export function getStaticPaths() {
  return categories.map((c: any) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props as any;
const count = fa(products.filter((p: any) => p.category === cat.id).length);
const journalHit = articles.find((a: any) => a.title.includes(cat.name.replace(' و ', ' ').split(' ')[0]));
const bannerImg = cat.banner || cat.image;
---

<Base title={`${cat.name} | فروشگاه پارسی‌مزون`} desc={cat.desc}>
  <section class="cat-banner">
    <img src={img(bannerImg)} alt={`دسته‌بندی ${cat.name}`} width="1280" height="720" fetchpriority="high" />
    <div class="cat-banner__body">
      <p class="editorial__cat" style="color:var(--c-accent)">دسته‌بندی</p>
      <h1 class="cat-banner__t">{cat.name}</h1>
      <p class="cat-banner__d">{cat.desc}</p>
      <div class="shop-head-meta" style="margin-top:10px;color:rgba(255,255,255,.8)">
        <span><b style="color:#fff">{count}</b> محصول در این دسته</span>
      </div>
    </div>
  </section>

  <ShopBrowser showCats={false} />

  {journalHit && (
    <section class="section section--ivory">
      <div class="container">
        <a href={`${BASE}/journal/${journalHit.slug}`} style="display:grid;grid-template-columns:minmax(0,320px) 1fr;gap:24px;align-items:center" class="reveal">
          <img src={img(journalHit.cover)} alt={journalHit.title} loading="lazy" width="320" height="213" style="aspect-ratio:3/2;object-fit:cover" />
          <div>
            <p class="editorial__cat" style="color:var(--c-primary)">{journalHit.category} — مجله پارسی‌مزون</p>
            <h2 class="section-title" style="margin:6px 0">{journalHit.title}</h2>
            <p style="font-size:13.5px;color:var(--c-text-soft);max-width:560px">{journalHit.excerpt}</p>
            <span class="link-underline" style="display:inline-block;margin-top:10px;color:var(--c-primary)">مطالعه مقاله ←</span>
          </div>
        </a>
      </div>
    </section>
  )}
</Base>
