---
import Base from '../layouts/Base.astro';
import { BASE } from '../lib/site';
---

<Base title="پرداخت آزمایشی" desc="درگاه پرداخت آزمایشی پارسی‌مزون — بدون برداشت واقعی">
  <div class="container">
    <div class="gateway" id="gateway">
      <div class="gateway__head">
        <b>درگاه پرداخت آزمایشی</b>
        <span style="font-size:11.5px; background:rgba(255,255,255,.2); padding:3px 10px; border-radius:99px">DEMO</span>
      </div>
      <div class="gateway__body" id="gateway-body">
        <p class="gateway__amount">مبلغ قابل پرداخت</p>
        <p class="gateway__num" id="pay-amount"></p>
        <div class="gateway__card">
          <p style="font-size:12px; color:var(--c-text-soft); text-align:center">شماره کارت تست: <b dir="ltr">6104-3379-0000-0000</b></p>
          <input id="card-num" maxlength="19" placeholder="---- ---- ---- ----" dir="ltr" aria-label="شماره کارت" />
        </div>
        <div class="gateway__meta">
          <input id="card-cvv" maxlength="4" placeholder="CVV2" dir="ltr" aria-label="CVV2" />
          <input id="card-pin" type="password" maxlength="8" placeholder="رمز دوم" aria-label="رمز" />
        </div>
        <p style="font-size:11.5px; color:var(--c-warning); margin-top:10px; text-align:center">💡 برای شبیه‌سازی پرداخت ناموفق، رمز دوم را <b>1234</b> وارد کنید؛ هر رمز دیگری = پرداخت موفق</p>
        <button class="btn btn-primary btn-block" style="margin-top:16px" id="pay-btn">پرداخت</button>
        <p style="font-size:11.5px; color:var(--c-text-soft); text-align:center; margin-top:12px">این درگاه کاملاً شبیه‌سازی‌شده است و اتصالی به بانک ندارد.</p>
      </div>
      <div class="gateway__body" id="paying" style="display:none; text-align:center">
        <div class="spinner"></div>
        <p style="font-weight:700">در حال پردازش پرداخت…</p>
        <p class="product-card__cat">لطفاً صفحه را نبندید</p>
      </div>
    </div>
  </div>
</Base>

<script>
  /* اسکریپت باندل‌شده Astro (module — بعد از بارگذاری DOM اجرا می‌شود) */
  import { createOrder, setCart } from '../lib/store';

  const base = document.querySelector('link[rel=icon]')!.getAttribute('href')!.replace('/favicon.svg', '');
  const fa = (n: number) => new Intl.NumberFormat('fa-IR').format(n);
  const pending = JSON.parse(sessionStorage.getItem('ps_pending_order') || 'null');

  function finish(order: any, shipCost: number, total: number, payMethod: string, payOk = true) {
    if (!payOk) {
      document.getElementById('gateway')!.innerHTML = `
        <div class="gateway__head"><b>نتیجه پرداخت</b></div>
        <div class="gateway__body">
          <div class="pay-result">
            <div class="pay-result__icon pay-result__icon--no">✕</div>
            <p class="pay-result__t">پرداخت ناموفق بود</p>
            <p class="pay-result__s">پسورد تست 1234 وارد شده است. سفارشی ثبت نشد.</p>
            <div style="display:flex; gap:10px; justify-content:center; margin-top:18px">
              <a class="btn btn-default" href="${base}/checkout/">بازگشت به تسویه</a>
            </div>
          </div>
        </div>`;
      return;
    }
    const created = createOrder({
      customer: order.customer,
      items: order.items, /* اقلام کامل (نام، تنوع، قیمت) برای نمایش رسید و پنل مدیریت */
      subtotal: order.subtotal,
      discount: order.discount,
      coupon: order.coupon,
      shipping: shipCost,
      total,
      shippingMethod: order.shippingMethod,
      paymentMethod: payMethod,
    });
    setCart([]);
    sessionStorage.removeItem('ps_pending_order');
    sessionStorage.removeItem('ps_checkout_ctx');
    window.location.href = base + '/order-confirm/?code=' + created.code;
  }

  if (!pending) {
    window.location.href = base + '/cart/';
  } else {
    const cod = new URLSearchParams(location.search).get('cod') === '1';
    const ship = pending.subtotal >= 3000000 ? 0 : 89000;
    const total = Math.max(0, pending.subtotal - pending.discount) + ship;

    if (cod) {
      finish(pending, ship, total, 'cod');
    } else {
      document.getElementById('pay-amount')!.textContent = fa(total) + ' تومان';
      const cardNum = document.getElementById('card-num') as HTMLInputElement;
      cardNum.addEventListener('input', () => {
        cardNum.value = cardNum.value.replace(/\D/g, '').slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1-');
      });
      document.getElementById('pay-btn')!.addEventListener('click', () => {
        const num = cardNum.value.replace(/\D/g, '');
        if (num.length < 8) {
          cardNum.focus();
          cardNum.style.borderColor = 'var(--c-primary)';
          return;
        }
        (document.getElementById('gateway-body') as HTMLElement).style.display = 'none';
        (document.getElementById('paying') as HTMLElement).style.display = 'block';
        setTimeout(() => {
          const pin = (document.getElementById('card-pin') as HTMLInputElement).value;
          const ok = pin !== '1234';
          finish(pending, ship, total, 'gateway', ok);
        }, 2000);
      });
    }
  }
</script>
