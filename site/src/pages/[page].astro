---
import Base from '../layouts/Base.astro';
import { BASE, staticPages, img, fa, settings } from '../lib/site';

export function getStaticPaths() {
  return staticPages.map((pg: any) => ({ params: { page: pg.slug }, props: { pg } }));
}
const { pg } = Astro.props as any;
const isContact = pg.slug === 'contact';
const isFaq = pg.slug === 'faq';
const blocks = (pg.body || '').split('\n\n').filter(Boolean);
---

<Base title={pg.title} desc={`${pg.title} — پارسی‌مزون`}>
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__t">{pg.title}</h1>
      <p class="breadcrumb"><a href={BASE + '/'}>خانه</a> / {pg.title}</p>
    </div>
  </section>

  <div class="container page-content">
    {pg.image ? <img src={img(pg.image)} alt={pg.title} style="width:100%; aspect-ratio:4/3; object-fit:cover; margin-bottom:24px" width="800" height="600" /> : null}

    {isContact ? (
      <div class="contact-grid" id="contact-grid">
        <div class="contact-card">
          <p><b>📞 تلفن:</b> <span dir="ltr">۰۲۱-۹۱۰۰۲۲۳۳</span></p>
          <p><b>✉️ ایمیل:</b> <span dir="ltr">info@parsimezon-demo.ir</span></p>
          <p><b>🕘 ساعات کاری:</b> شنبه تا پنجشنبه ۹ تا ۱۸</p>
          <p><b>📍 آدرس:</b> تهران، خیابان ولیعصر، پاساژ رویال، طبقه دوم، واحد ۲۰۴</p>
          <div class="footer-social" style="margin-top:14px">
            <a href={settings.socials.instagram} aria-label="اینستاگرام" rel="noopener" style="color:var(--c-ink);background:var(--c-surface)"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
            <a href={settings.socials.telegram} aria-label="تلگرام" rel="noopener" style="color:var(--c-ink);background:var(--c-surface)"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M21 4L2.5 11.3l5.6 1.7L10 19l2.9-3.6 4.7 3.4L21 4z"/></svg></a>
          </div>
        </div>
        <div class="checkout-card">
          <p class="checkout-card__t">ارسال پیام</p>
          <form id="contact-form">
            <div class="field" style="margin-bottom:12px"><label>نام *</label><input name="cname" required /></div>
            <div class="field" style="margin-bottom:12px"><label>موبایل *</label><input name="cphone" inputmode="tel" required pattern="0\d{10}" placeholder="09xxxxxxxxx" /></div>
            <div class="field" style="margin-bottom:12px"><label>موضوع</label><input name="csubject" /></div>
            <div class="field" style="margin-bottom:16px"><label>متن پیام *</label><textarea name="ctext" rows="4" required></textarea></div>
            <button class="btn btn-primary btn-block">ارسال پیام</button>
            <p class="notice notice--success" id="contact-ok" style="display:none; margin-top:14px">پیام شما ثبت شد ✓ (دمو — در پنل مدیریت بخش «پیام‌ها» قابل مشاهده است)</p>
          </form>
        </div>
      </div>
    ) : null}

    {blocks.map((p: string) => p.startsWith('## ') ? <h2>{p.slice(3)}</h2> : <p>{p}</p>)}

    {isFaq ? (
      <div>
        {(pg.faqs || []).map(([q, a]: any) => (
          <details class="faq-item">
            <summary>{q}</summary>
            <div class="faq-a">{a}</div>
          </details>
        ))}
        <p class="notice notice--info" style="margin-top:18px">💡 این نسخه دمو است؛ پرداخت واقعی انجام نمی‌شود و داده‌ها فقط در مرورگر شما ذخیره می‌شوند.</p>
      </div>
    ) : null}

    <div style="border-top:1px solid var(--c-border); margin-top:28px; padding-top:20px">
      <a class="btn btn-ghost" href={BASE + '/'}>بازگشت به خانه</a>
    </div>
  </div>
</Base>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', function (e) {
    e.preventDefault();
    const fd = new FormData(this);
    const messages = JSON.parse(localStorage.getItem('ps_messages') || '[]');
    messages.unshift({
      id: 'm' + Date.now(),
      name: fd.get('cname'), phone: fd.get('cphone'), email: '',
      subject: fd.get('csubject') || 'پیام از فرم تماس',
      text: fd.get('ctext'), date: new Date().toISOString().slice(0, 10), status: 'new',
    });
    localStorage.setItem('ps_messages', JSON.stringify(messages));
    this.querySelector('button').textContent = 'ارسال شد ✓';
    document.getElementById('contact-ok').style.display = 'block';
    this.querySelectorAll('input,textarea').forEach((x) => (x.value = ''));
  });
</script>
