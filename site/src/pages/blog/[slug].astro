---
import Base from '../../layouts/Base.astro';
import { BASE, img, posts, dateFa, fa } from '../../lib/site';

export function getStaticPaths() {
  return posts.map((b: any) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as any;
const paras = b.body.split('\n\n');
---

<Base title={b.title} desc={b.excerpt}>
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__t" style="font-size:24px">{b.title}</h1>
      <p class="breadcrumb"><a href={BASE + '/'}>خانه</a> / <a href={BASE + '/blog'}>مجله</a> / {b.title}</p>
    </div>
  </section>

  <div class="container" style="max-width:860px; padding:34px 20px">
    <img src={img(b.image)} alt={b.title} style="width:100%; aspect-ratio:3/2; object-fit:cover" width="800" height="533" />
    <div style="display:flex; gap:14px; margin:18px 0; font-size:12.5px; color:var(--c-text-soft)">
      <span>دسته: <b style="color:var(--c-text)">{b.category}</b></span>
      <span>تاریخ: {dateFa(b.date)}</span>
      <span>برچسب‌ها: {b.tags.join(' ، ')}</span>
    </div>
    <p style="font-size:16px; font-weight:600; line-height:2.4; border-right:3px solid var(--c-primary); padding-right:16px; margin-bottom:22px">{b.excerpt}</p>
    {paras.map((p: string) => <p style="font-size:15px; line-height:2.5; margin-bottom:18px">{p}</p>)}

    <div style="border-top:1px solid var(--c-border); margin-top:30px; padding-top:22px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px">
      <a class="btn btn-default" href={BASE + '/blog'}>بازگشت به مجله</a>
      <a class="btn btn-primary" href={BASE + '/shop'}>مشاهده محصولات پارسی‌مزون</a>
    </div>
  </div>
</Base>
