---
import { BASE, settings, categories } from '../lib/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="feature">
        <div class="feature__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 8h13v9H1zM14 11h4l3 3v3h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/></svg>
        </div>
        <div><p class="feature__t">ارسال سریع</p><p class="feature__s">پردازش همان روز؛ رایگان بالای ۳ میلیون</p></div>
      </div>
      <div class="feature">
        <div class="feature__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6"/></svg>
        </div>
        <div><p class="feature__t">۷ روز بازگشت</p><p class="feature__s">ضمانت بازگشت و تعویض سایز</p></div>
      </div>
      <div class="feature">
        <div class="feature__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        </div>
        <div><p class="feature__t">پرداخت امن دمو</p><p class="feature__s">درگاه آزمایشی بدون برداشت واقعی</p></div>
      </div>
      <div class="feature">
        <div class="feature__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12c0 4.4-4 8-9 8-1.2 0-2.4-.2-3.4-.6L3 21l1.7-4.3C3.6 15.4 3 13.8 3 12c0-4.4 4-8 9-8s9 3.6 9 8z"/></svg>
        </div>
        <div><p class="feature__t">مشاوره سایز</p><p class="feature__s">پشتیبانی واقعی در روزهای کاری</p></div>
      </div>
    </div>

    <div class="footer-main">
      <div class="footer-col footer-about">
        <a class="logo" href={BASE + '/'}>
          <svg class="logo__mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <rect width="48" height="48" rx="2" fill="#ED1844"/>
            <path d="M14 34V14h4v10h4V14h4v20h-4v-6h-4v6h-4z" fill="#fff"/>
            <circle cx="34" cy="17" r="4" fill="#FBBC34"/>
          </svg>
          <span class="logo__text" style="color:#fff">پارسی<i>مزون</i></span>
        </a>
        <p>{settings.tagline} — انتخاب‌های شیک و باکیفیت برای زنانی که به ظاهرشان اهمیت می‌دهند. ارسال به سراسر کشور، ضمانت اصالت و ۷ روز مهلت بازگشت کالا.</p>
        <div class="footer-social">
          <a href={settings.socials.instagram} aria-label="اینستاگرام" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
          <a href={settings.socials.telegram} aria-label="تلگرام" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M21 4L2.5 11.3l5.6 1.7L10 19l2.9-3.6 4.7 3.4L21 4z"/></svg></a>
          <a href={settings.socials.whatsapp} aria-label="واتساپ" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3zm4.6 12.6c-.2.6-1.2 1.1-1.7 1.1-.4.1-1 .1-1.6-.1a13 13 0 0 1-5.7-4.9c-.5-.7-.9-1.5-.9-2.2 0-.8.4-1.2.6-1.4.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .5.4l.8 1.8c.1.2 0 .3-.1.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.7.8c.3.2.5.3.5.4.1.1.1.5-.1 1z"/></svg></a>
          <a href={settings.socials.pinterest} aria-label="پینترست" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.7-.2-1.9 0-2.7l1.1-4.6s-.3-.6-.3-1.4c0-1.3.8-2.3 1.7-2.3.8 0 1.2.6 1.2 1.3 0 .8-.5 2-.8 3.1-.2.9.5 1.7 1.4 1.7 1.7 0 3-1.8 3-4.4 0-2.3-1.6-3.9-4-3.9-2.7 0-4.3 2-4.3 4.1 0 .8.3 1.7.7 2.2l-1 .8c-.5-.9-.8-2-.8-3 0-2.9 2.1-5.5 6.1-5.5 3.2 0 5.7 2.3 5.7 5.3 0 3.2-2 5.8-4.8 5.8-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.8-.8 1.9-1.2 2.5A9 9 0 1 0 12 3z"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <p class="footer-col__t">دسته‌بندی‌ها</p>
        {categories.slice(0, 8).map((c: any) => <a href={`${BASE}/category/${c.slug}`}>{c.name}</a>)}
        <a href={`${BASE}/shop`}>همه محصولات ←</a>
      </div>
      <div class="footer-col">
        <p class="footer-col__t">خدمات مشتریان</p>
        <a href={BASE + '/contact'}>تماس با ما</a>
        <a href={BASE + '/faq'}>سوالات متداول</a>
        <a href={BASE + '/shipping-returns'}>ارسال و بازگشت کالا</a>
        <a href={BASE + '/size-guide'}>راهنمای سایز</a>
        <a href={BASE + '/track-order'}>پیگیری سفارش</a>
        <a href={BASE + '/payments'}>روش‌های پرداخت</a>
        <a href={BASE + '/terms'}>قوانین و مقررات</a>
        <a href={BASE + '/privacy'}>حریم خصوصی</a>
      </div>
      <div class="footer-col">
        <p class="footer-col__t">راهنمای خرید</p>
        <a href={BASE + '/buying-guide'}>راهنمای خرید از پارسی‌مزون</a>
        <a href={BASE + '/journal'}>مجله پارسی‌مزون</a>
        <a href={BASE + '/journal/size-guide-online'}>راهنمای انتخاب سایز</a>
        <a href={BASE + '/journal/fabric-guide'}>شناخت پارچه‌ها</a>
        <a href={BASE + '/journal/online-clothing-buying-guide'}>راهنمای خرید آنلاین</a>
        <a href={BASE + '/lookbook'}>لوک‌بوک استایل‌ها</a>
        <a href={BASE + '/new-arrivals'}>جدیدترین محصولات</a>
        <a href={BASE + '/bestsellers'}>پرفروش‌ترین‌ها</a>
      </div>
      <div class="footer-col">
        <p class="footer-col__t">خبرنامه پارسی‌مزون</p>
        <p style="font-size:12.5px; line-height:2">از تخفیف‌ها، کالکشن‌های تازه و مقالات استایل زودتر از همه باخبر شوید.</p>
        <form class="footer-news" id="footer-news">
          <input type="email" placeholder="ایمیل شما" aria-label="ایمیل" />
          <button type="submit">عضویت</button>
        </form>
        <p style="font-size:12px; margin-top:16px; line-height:2.2; color:rgba(255,255,255,.55)">
          {settings.phone}<br />{settings.address}
        </p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© ۱۴۰۴ پارسی‌مزون — تمامی حقوق محفوظ است. | طراحی و توسعه توسط <a href="https://cdanesh.ir/" target="_blank" rel="noopener" style="color:var(--c-accent)">کافه دانش</a></span>
      <div class="footer-badges">
        <span>پرداخت امن دمو</span>
        <span>ارسال سریع</span>
        <span>ضمانت ۷ روزه</span>
        <span>اصالت کالا</span>
      </div>
    </div>
  </div>
</footer>
<script is:inline>
  document.getElementById('footer-news')?.addEventListener('submit', function (e) {
    e.preventDefault();
    this.querySelector('input').value = '';
    const btn = this.querySelector('button');
    btn.textContent = 'ثبت شد ✓';
    setTimeout(() => (btn.textContent = 'عضویت'), 2400);
  });
</script>
